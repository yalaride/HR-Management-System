# MongoDB Atlas connection string (include database name, e.g. ...mongodb.net/hrm_system?...)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/hrm_system?retryWrites=true&w=majority

# One-time admin seed (remove SEED_ADMIN_PASSWORD after running npm run seed:admin)
SEED_ADMIN_EMAIL=admin@syncup.com
SEED_ADMIN_PASSWORD=ChangeMe_StrongPass123!
# SEED_ADMIN_RESET_PASSWORD=true

# NextAuth — generate your own with: openssl rand -base64 32
NEXTAUTH_SECRET=2KEDv27VD/6+2UvFTxVrRj9FZqKTR5xSFFtprfDjDNU=
# Production domain, e.g. https://hr.yourcompany.com (http://localhost:3000 for dev)
NEXTAUTH_URL=http://localhost:3000

# Cloudinary — copy CLOUDINARY_URL from dashboard (Settings → API Keys → "API environment variable")
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyzAB@your_cloud_name
# Or set these three separately (must all be from the same cloud):
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyzAB
CLOUDINARY_UPLOAD_FOLDER=hr-system/employees

# Resend — HR system only (separate API key + domain from other products)
# 1. Resend dashboard → API keys → Create "HR Management System"
# 2. Domains → Add HR domain (e.g. mail.syncup.com) — do NOT reuse mail.yalaride.com
RESEND_API_KEY=re_AbCdEfGhIjKlMnOpQrStUvWxYz123456
# Sender on verified HR domain, e.g. HR Team <hr@mail.syncup.com>
# Dev/testing without domain: HR System <onboarding@resend.dev>
#   (sandbox only delivers to your Resend account owner's email)
RESEND_FROM_EMAIL=HR System <onboarding@resend.dev>

# Cron protection (REQUIRED in production) — generate your own with: openssl rand -hex 32
# Used by: /api/admin/birthdays/cron and /api/admin/employee-attendance/cron
# Vercel → Project Settings → Environment Variables → add CRON_SECRET (same value)
# Without this, birthday emails never send (cron returns 401).
# Example format (do NOT reuse this in production — generate a fresh one):
CRON_SECRET=c8d181000edbc717bfd7f3b2a75fb6f8ea98d71d0870a6103df1b357d88f5984

# Fingerprint device (Hikvision) pushes punches to /api/hikvision/events/<this secret>
# Generate with: openssl rand -hex 24
# Set the same value in Vercel → Project Settings → Environment Variables.
# HIKVISION_LISTENER_SECRET=

# Optional: extra employee emails allowed to view full company Activity Logs
# (ubaidullah2305@gmail.com is always included in code). Comma-separated.
# AUDIT_LOG_VIEWER_EMAILS=other@company.com
